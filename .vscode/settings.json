{
  // Local workstation: bright warm red bars. On the VM, open bf-cbom-vm.code-workspace for deep burgundy:
  // a workspace file's colors replace these (folder-level window settings are ignored in a workspace).
  "workbench.colorCustomizations": {
    "titleBar.activeBackground": "#D33C32",
    "titleBar.activeForeground": "#ffffff",
    "titleBar.inactiveBackground": "#A93730",
    "titleBar.inactiveForeground": "#ffffffcc",
    "titleBar.border": "#EF7564",
    // Darken the command center slightly to keep white text readable in every state.
    "commandCenter.background": "#00000020",
    "commandCenter.foreground": "#ffffff",
    "commandCenter.activeBackground": "#00000040",
    "commandCenter.activeForeground": "#ffffff",
    "commandCenter.border": "#ffffff40",
    "activityBar.background": "#BC352D",
    "activityBar.foreground": "#ffffff",
    "activityBar.inactiveForeground": "#ffffffcc",
    "activityBar.activeBorder": "#ffffff",
    "activityBar.border": "#D33C32",
    "activityBarBadge.background": "#ffffff",
    "activityBarBadge.foreground": "#BC352D",
    "statusBar.background": "#BC352D",
    "statusBar.foreground": "#ffffff",
    "statusBar.border": "#D33C32",
    "statusBar.noFolderBackground": "#BC352D",
    "statusBar.noFolderForeground": "#ffffff"
  }
}
