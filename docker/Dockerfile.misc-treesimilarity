# syntax=docker/dockerfile:1.7
# docker/Dockerfile.misc-treesimilarity
# Dedicated container for the tree similarity worker that builds the
# native pybind11 extension linking against OR-Tools.

# amd64-only on purpose: links against the prebuilt amd64 OR-Tools release below.
FROM ghcr.io/astral-sh/uv:0.12.5@sha256:e85be844203885286c60ffad8a858d48afb6c5a5c237ca0e67f12e74b8f174b1 AS uv
FROM --platform=linux/amd64 ubuntu:24.04@sha256:534baea6a22c03a63003dbc8dbe78fe34bc0d7e595d9a9dc9834884ff530eb55

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# System dependencies for building the extension and running the worker
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        git \
        curl \
        ca-certificates \
        tini \
        pkg-config \
        python3 \
        python3-pip \
        python3-venv \
        python3-dev \
        xz-utils \
        libeigen3-dev \
    && rm -rf /var/lib/apt/lists/*

# Python tooling (uv for consistency with other workers)
COPY --from=uv /uv /uvx /usr/local/bin/
ENV UV_LINK_MODE=copy

# Create non-root user and workspace
# ubuntu:24.04 already ships uid 1000 (ubuntu), so pin appuser to 1001
RUN useradd -m -u 1001 appuser && mkdir -p /app && chown -R appuser:appuser /app
ENV PATH="/home/appuser/.local/bin:${PATH}"
USER appuser
WORKDIR /app

# Copy project manifests for dependency installation
COPY --chown=appuser:appuser pyproject.toml uv.lock README.md LICENSE ./

# Prepare virtual environment with project dependencies (without installing the root project)
RUN --mount=type=cache,target=/home/appuser/.cache/uv,uid=1001,gid=1001 \
    uv sync --frozen --no-dev --no-install-project

# Fetch required third-party dependencies into the expected external/ folder
# (pinned commits; bump deliberately)
ARG EIGEN_REF=1888fad464fd2f25923cbd498f00aa51285c89c3
ARG CJSON_REF=6d9f2443ab071f86e5d9b43025a40929ec41c46c
ARG TREESIM_REF=f20ad2ffb2852ebee6033775cdaa369e0cf4b7fd
RUN set -e; ext=misc/treesimilartiy/external; mkdir -p "$ext"; \
    fetch() { git init -q "$ext/$1" && git -C "$ext/$1" fetch -q --depth 1 "$2" "$3" && git -C "$ext/$1" checkout -q FETCH_HEAD; }; \
    fetch eigen https://gitlab.com/libeigen/eigen.git "$EIGEN_REF"; \
    fetch cJSON https://github.com/DaveGamble/cJSON.git "$CJSON_REF"; \
    fetch tree-similarity https://github.com/DatabaseGroup/tree-similarity.git "$TREESIM_REF"

# Download and unpack the official OR-Tools binary release (override ORTOOLS_URL if needed)
ARG ORTOOLS_URL="https://github.com/google/or-tools/releases/download/v9.12/or-tools_amd64_ubuntu-24.04_cpp_v9.12.4544.tar.gz"
USER root
RUN curl -#Lf --retry 5 --retry-all-errors --retry-delay 5 "$ORTOOLS_URL" -o /tmp/or-tools.tar.gz \
    && mkdir -p /opt/or-tools \
    && tar -xzf /tmp/or-tools.tar.gz -C /opt/or-tools --strip-components=1 \
    && rm /tmp/or-tools.tar.gz
USER appuser
ENV LD_LIBRARY_PATH=/opt/or-tools/lib
ENV CMAKE_PREFIX_PATH=/opt/or-tools/lib/cmake

# Provide CMake with the OR-Tools config path
ENV ortools_DIR=/opt/or-tools/lib/cmake/ortools

# Tree similarity sources after the downloads: editing them never re-fetches OR-Tools or the externals
COPY --chown=appuser:appuser misc/treesimilartiy/ ./misc/treesimilartiy/

# Build the native pybind11 extension
RUN cmake -S misc/treesimilartiy -B misc/treesimilartiy/build -DPython3_EXECUTABLE=$(which python3) -Dortools_DIR=${ortools_DIR} \
    && cmake --build misc/treesimilartiy/build --config Release

# Shared code last: editing it never invalidates the layers above
COPY --chown=appuser:appuser common/ ./common/

# Ensure the extension is importable
ENV PYTHONPATH=/app:/app/misc/treesimilartiy/build

ENTRYPOINT ["tini", "-g", "--", "uv", "run", "--frozen", "--no-dev", "python", "misc/treesimilartiy/src/main.py"]
