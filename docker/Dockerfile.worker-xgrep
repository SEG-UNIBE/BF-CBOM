# syntax=docker/dockerfile:1.7
# docker/Dockerfile.worker-xgrep
# Mondoo xgrep (free of charge, LicenseRef-Mondoo-Proprietary). The binary is taken from the public
# npm package at build time and verified against the registry's sha512.
# Pinned to 0.80.0, the version the pilot of 2026-10-08 graded.
ARG BASE_IMAGE=base
ARG BASE_TAG=latest
FROM ${BASE_IMAGE}:${BASE_TAG}

ARG XGREP_VERSION=0.86.0
# sha512 (hex) of @mondoohq/xgrep_linux_<arch>-<version>.tgz, from the npm registry's dist.integrity
ARG XGREP_SHA512_AMD64=fd10fc06c7b32d686a1f95e5f45a5f7d8066ef75f29d0ec30e186ac0ac1f9fa8436cb1dab184c6546a99638a51f0cd2106caba9f881422b9cbc965a6fe0c6776
ARG XGREP_SHA512_ARM64=f552a948d10158659944631c199a07c0afe11836c1f15a7b250df3085880a4c0a8a5f2118df0d18f220c04ac73ef9ef4ea6f0f2a2b7c136d2326ec3e323b66cf
ARG TARGETARCH

USER root
RUN set -eu; \
    case "${TARGETARCH}" in \
      amd64) sum="${XGREP_SHA512_AMD64}";; \
      arm64) sum="${XGREP_SHA512_ARM64}";; \
      *) echo "unsupported arch ${TARGETARCH}" >&2; exit 1;; \
    esac; \
    url="https://registry.npmjs.org/@mondoohq/xgrep_linux_${TARGETARCH}/-/xgrep_linux_${TARGETARCH}-${XGREP_VERSION}.tgz"; \
    curl -fsSL --retry 5 --retry-delay 5 -o /tmp/xgrep.tgz "$url"; \
    echo "${sum}  /tmp/xgrep.tgz" | sha512sum -c -; \
    mkdir -p /tmp/xg && tar -xzf /tmp/xgrep.tgz -C /tmp/xg; \
    install -m 0755 "$(find /tmp/xg -type f -name xgrep | head -1)" /usr/local/bin/xgrep; \
    rm -rf /tmp/xg /tmp/xgrep.tgz; \
    HOME=/tmp XGREP_UPDATE_CHECK=0 DO_NOT_TRACK=1 xgrep version
ENV TOOL_VERSION="xgrep ${XGREP_VERSION}" XGREP_UPDATE_CHECK=0 DO_NOT_TRACK=1

USER appuser
WORKDIR /app
ENV PYTHONPATH=/app

COPY --chown=appuser:appuser pyproject.toml uv.lock ./
COPY --chown=appuser:appuser common/ ./common/
RUN --mount=type=cache,target=/home/appuser/.cache/uv,uid=1000,gid=1000 \
    uv sync --frozen --no-dev

COPY --chown=appuser:appuser workers/xgrep/ ./workers/xgrep/

ENTRYPOINT ["tini", "-g", "--", "uv", "run", "--frozen", "--no-dev", "workers/xgrep/main.py"]

# BF-CBOM commit this image was built from (compose/bake pass it; last, so it never invalidates the layers above)
ARG BF_CBOM_COMMIT=unknown
ENV BF_CBOM_COMMIT=${BF_CBOM_COMMIT}
