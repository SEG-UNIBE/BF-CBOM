# syntax=docker/dockerfile:1.7
# docker/Dockerfile.worker-ciphersift
# CipherSift (Apache-2.0, https://github.com/SEG-UNIBE/ciphersift): built from the source archive of a release
# tag, pinned by sha256 (bump deliberately, see notes.md "CipherSift"). Java 23+ tool with bundled tree-sitter
# natives (compiled from the sources vendored in the release), run on a Temurin 25 JRE in our base image.
ARG BASE_IMAGE=base
ARG BASE_TAG=latest

# Temurin 25 JRE (image index digest, 2026-10-17); only /opt/java/openjdk is taken
FROM eclipse-temurin:25-jre@sha256:dbb43d81099eec91e0800226ed2296d03146ee7857165b95112372ad0d67e87f AS jre

# ---- build stage: the release's own build (its Dockerfile does the same)
# Maven 3.9 on Temurin 25 JDK (image index digest, 2026-10-17)
FROM maven:3.9-eclipse-temurin-25@sha256:93b8a14ea2f412782e4e842651273b4d903e35cc496284f178fbbe2d67d00976 AS build
ARG CIPHERSIFT_VERSION=1.1.1
ARG CIPHERSIFT_SHA256=52225cfe0e16397f196ea58427949c044d89157199d2bc40fc1d865024bf3434
RUN apt-get update \
 && apt-get install -y --no-install-recommends gcc libc6-dev \
 && rm -rf /var/lib/apt/lists/*
ADD --checksum=sha256:${CIPHERSIFT_SHA256} --chmod=644 \
    https://github.com/SEG-UNIBE/ciphersift/archive/refs/tags/v${CIPHERSIFT_VERSION}.tar.gz /tmp/ciphersift.tar.gz
RUN useradd --create-home --uid 10001 builder && mkdir -p /src /opt/ciphersift && chown builder /src /opt/ciphersift
# build as an unprivileged user (nothing in the build needs root)
USER builder
WORKDIR /src
RUN tar xzf /tmp/ciphersift.tar.gz --strip-components=1
# `mvn verify` gates the image: natives, bundled-rule validation, unit tests, the conformance suite (CycloneDX
# 1.7 and 1.6 schema validation of every produced CBOM, determinism checks) and licence headers.
RUN --mount=type=cache,target=/home/builder/.m2,uid=10001 \
    MAVEN_CONFIG= mvn -B -ntp -Dmaven.repo.local=/home/builder/.m2/repository verify \
 && cp target/ciphersift-*-all.jar /opt/ciphersift/ciphersift.jar \
 && cp LICENSE NOTICE /opt/ciphersift/

# ---- runtime
FROM ${BASE_IMAGE}:${BASE_TAG}
ARG CIPHERSIFT_VERSION=1.1.1
COPY --from=jre /opt/java/openjdk /opt/java/openjdk
COPY --from=build /opt/ciphersift /opt/ciphersift
# natives are extracted to $XDG_CACHE_HOME/ciphersift/native/ on first use (must be private to the user)
ENV JAVA_HOME=/opt/java/openjdk \
    CIPHERSIFT_JAR=/opt/ciphersift/ciphersift.jar \
    CIPHERSIFT_RELEASE=v${CIPHERSIFT_VERSION} \
    XDG_CACHE_HOME=/tmp/ciphersift-cache \
    LC_ALL=C.UTF-8

USER appuser
WORKDIR /app
ENV PYTHONPATH=/app

COPY --chown=appuser:appuser pyproject.toml uv.lock ./
COPY --chown=appuser:appuser common/ ./common/
RUN --mount=type=cache,target=/home/appuser/.cache/uv,uid=1000,gid=1000 \
    uv sync --frozen --no-dev

COPY --chown=appuser:appuser workers/ciphersift/ ./workers/ciphersift/

ENTRYPOINT ["tini", "-g", "--", "uv", "run", "--frozen", "--no-dev", "workers/ciphersift/main.py"]
