# syntax=docker/dockerfile:1.7
# docker/Dockerfile.worker-qscan
# qScan (quantakrypto/pqc-tools, Apache-2.0): TypeScript pattern scanner, CycloneDX 1.6 CBOM with --format cbom.
# The pinned npm release is installed in a Node stage; node and the package are copied into the runtime.
# Offline: its optional LLM triage (--triage) and supply-chain audit (--audit) are never enabled. Disqualified by
# the bar exam (2026-10-23); run on bar-micro only.
ARG BASE_IMAGE=base
ARG BASE_TAG=latest

# ---- build stage (image index digest of node:22-bookworm-slim = node 22.23.3, 2026-10-19)
FROM node:22-bookworm-slim@sha256:c3de60bf2f9dd0ac6370e6117950ff62d6e339527e7472301c9c78a017978392 AS nodebuild
ARG QSCAN_VERSION=0.12.0
RUN npm install --global --no-fund --no-audit "@quantakrypto/qscan@${QSCAN_VERSION}" \
 && qscan --version

# ---- runtime
FROM ${BASE_IMAGE}:${BASE_TAG}
ARG QSCAN_VERSION=0.12.0
USER root
COPY --from=nodebuild /usr/local/bin/node /usr/local/bin/node
COPY --from=nodebuild /usr/local/lib/node_modules/@quantakrypto /usr/local/lib/node_modules/@quantakrypto
RUN ln -s /usr/local/lib/node_modules/@quantakrypto/qscan/dist/cli.js /usr/local/bin/qscan \
 && node --version && qscan --version
ENV TOOL_VERSION="qscan ${QSCAN_VERSION}" DO_NOT_TRACK=1

USER appuser
WORKDIR /app
ENV PYTHONPATH=/app

COPY --chown=appuser:appuser pyproject.toml uv.lock ./
COPY --chown=appuser:appuser common/ ./common/
RUN --mount=type=cache,target=/home/appuser/.cache/uv,uid=1000,gid=1000 \
    uv sync --frozen --no-dev

COPY --chown=appuser:appuser workers/qscan/ ./workers/qscan/

ENTRYPOINT ["tini", "-g", "--", "uv", "run", "--frozen", "--no-dev", "workers/qscan/main.py"]

# BF-CBOM commit this image was built from (compose/bake pass it; last, so it never invalidates the layers above)
ARG BF_CBOM_COMMIT=unknown
ENV BF_CBOM_COMMIT=${BF_CBOM_COMMIT}
