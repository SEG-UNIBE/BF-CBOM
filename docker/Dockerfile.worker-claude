# syntax=docker/dockerfile:1.7
# docker/Dockerfile.worker-claude (Anthropic; same layout as the other LLM workers)
ARG BASE_IMAGE=base
ARG BASE_TAG=latest
FROM ${BASE_IMAGE}:${BASE_TAG}
USER appuser

COPY --chown=appuser:appuser pyproject.toml uv.lock ./
COPY --chown=appuser:appuser common/ ./common/
RUN --mount=type=cache,target=/home/appuser/.cache/uv,uid=1000,gid=1000 \
    uv sync --frozen --no-dev

COPY --chown=appuser:appuser workers/claude/ ./workers/claude/
ENV PYTHONPATH=/app
ENTRYPOINT ["tini","-g","--","uv", "run", "--frozen", "--no-dev","workers/claude/main.py"]
