# syntax=docker/dockerfile:1.7
# docker/Dockerfile.base
# Pinned by digest for reproducible builds (bump deliberately).
FROM ghcr.io/astral-sh/uv:0.12.5@sha256:e85be844203885286c60ffad8a858d48afb6c5a5c237ca0e67f12e74b8f174b1 AS uv
FROM python:3.12-slim-trixie@sha256:a6e34c598f2467ed0e9a8d349809fcd8b5c603269512df273a0bb1784edc11b1

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    UV_SYSTEM_PYTHON=1 \
    UV_LINK_MODE=copy

# Minimal OS deps; include toolchain for native wheels when needed
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    git \
    tini \
    build-essential \
    pkg-config \
    libssl-dev \
    libffi-dev \
 && rm -rf /var/lib/apt/lists/* \
 && update-ca-certificates || true

# uv (Astral), pinned static binary
COPY --from=uv /uv /uvx /usr/local/bin/

# Non-root user and writable workdir
RUN useradd -m appuser && mkdir -p /app && chown -R appuser:appuser /app
WORKDIR /app
ENV PATH="/home/appuser/.local/bin:${PATH}"
USER appuser
