# syntax=docker/dockerfile:1.7
# Same interpreter as Dockerfile.base (common/ requires Python >= 3.12)
FROM python:3.12-slim-trixie@sha256:a6e34c598f2467ed0e9a8d349809fcd8b5c603269512df273a0bb1784edc11b1

RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# Pinned PyQuN commit (bump deliberately)
ARG PYQUN_REF=b11785329edbfc5ba994e92171152d0344bef9ee
RUN git clone https://github.com/RomanBoegli/PyQuN.git /opt/RaQuN_Lab \
 && git -C /opt/RaQuN_Lab checkout --detach ${PYQUN_REF}

WORKDIR /opt/RaQuN_Lab

RUN python3 -m venv /opt/RaQuN_Lab/.venv
ENV VIRTUAL_ENV=/opt/RaQuN_Lab/.venv
ENV PATH="$VIRTUAL_ENV/bin:$PATH"
ENV PYTHONPATH="/opt:${PYTHONPATH}"
RUN find /opt/RaQuN_Lab -type d -exec touch {}/__init__.py \;
RUN touch /opt/RaQuN_Lab/__init__.py

COPY common/ ./common/
# Deps pinned in misc/pyqun/requirements.txt (regenerate from requirements.in with uv pip compile)
COPY misc/pyqun/requirements.txt /tmp/requirements.txt
RUN --mount=type=cache,target=/root/.cache/pip \
    python3 -m pip install --timeout 120 -r /tmp/requirements.txt

COPY misc/pyqun/main.py /opt/RaQuN_Lab/main.py
COPY misc/pyqun/Stopwatch.py /opt/RaQuN_Lab/utils/Stopwatch.py
# COPY misc/pyqun/*.json /opt/RaQuN_Lab/

CMD ["python", "main.py"]
# ENTRYPOINT ["tini","-g","--","uv","run","--no-dev","workers/skeleton/main.py"]