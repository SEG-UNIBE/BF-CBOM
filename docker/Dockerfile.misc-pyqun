# syntax=docker/dockerfile:1.7
# docker/Dockerfile.misc-pyqun
# The UI's "Find Similar Components" worker: PyQuN's RaQuN over MiniLM embeddings (misc/pyqun/main.py); PyQuN and
# sentence-transformers come from uv.lock (the `raqun` and `similarity` extras).
ARG BASE_IMAGE=base
ARG BASE_TAG=latest
FROM ${BASE_IMAGE}:${BASE_TAG}
USER appuser

COPY --chown=appuser:appuser pyproject.toml uv.lock ./
COPY --chown=appuser:appuser common/ ./common/
RUN --mount=type=cache,target=/home/appuser/.cache/uv,uid=1000,gid=1000 \
    uv sync --frozen --no-dev --extra raqun --extra similarity

# The embedding model, baked in at a pinned Hugging Face revision (bump deliberately); every start is then offline
ARG MINILM_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
RUN uv run --frozen --no-dev python -c "from sentence_transformers import SentenceTransformer; \
    SentenceTransformer('sentence-transformers/all-MiniLM-L6-v2', revision='${MINILM_REVISION}')"
ENV MINILM_REVISION=${MINILM_REVISION} HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1

# our code last: editing it never invalidates the torch layer above
COPY --chown=appuser:appuser misc/pyqun/main.py ./misc/pyqun/main.py
ENV PYTHONPATH=/app
ENTRYPOINT ["tini", "-g", "--", "uv", "run", "--frozen", "--no-dev", "misc/pyqun/main.py"]

# BF-CBOM commit this image was built from (compose/bake pass it; last, so it never invalidates the layers above)
ARG BF_CBOM_COMMIT=unknown
ENV BF_CBOM_COMMIT=${BF_CBOM_COMMIT}
