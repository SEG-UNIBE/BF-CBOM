# syntax=docker/dockerfile:1.7
# docker/Dockerfile.coordinator
ARG BASE_IMAGE=base
ARG BASE_TAG=latest
FROM ${BASE_IMAGE}:${BASE_TAG}
USER root
RUN mkdir -p /data/results && chown appuser:appuser /data/results
USER appuser
WORKDIR /app

# Dependency resolution first (better caching)
COPY --chown=appuser:appuser pyproject.toml uv.lock ./
COPY --chown=appuser:appuser common/ ./common/
RUN --mount=type=cache,target=/home/appuser/.cache/uv,uid=1000,gid=1000 \
    uv sync --frozen --no-dev

# Now copy the actual service code
COPY --chown=appuser:appuser coordinator/ ./coordinator/
COPY --chown=appuser:appuser docs/ ./docs/

ENV PYTHONPATH=/app
ENV STREAMLIT_CONFIG=coordinator/.streamlit/config.toml

ENTRYPOINT ["tini", "-g", "--", "uv", "run", "--frozen", "--no-dev", "streamlit", "run", "coordinator/0_Start.py", "--server.port=8501", "--server.address=0.0.0.0"]
